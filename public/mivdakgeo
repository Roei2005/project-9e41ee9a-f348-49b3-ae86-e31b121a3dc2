                        <text x={A.x} y={A.y-10} textAnchor="middle" className="font-bold text-xl">A</text>
                        <text x={B.x-15} y={B.y+15} textAnchor="middle" className="font-bold text-xl">B</text>
                        <text x={C.x+15} y={C.y+15} textAnchor="middle" className="font-bold text-xl">C</text>
                        <text x={D.x-20} y={D.y} textAnchor="middle" className="font-bold text-xl">D</text>
                        <text x={E.x+20} y={E.y} textAnchor="middle" className="font-bold text-xl">E</text>
                        
                        {data.sideAD && <text x={130} y={60} textAnchor="middle" className="font-bold fill-indigo-700 text-2xl svg-text-bg">{data.sideAD}</text>}
                        {data.sideDB && <text x={80} y={150} textAnchor="middle" className="font-bold fill-indigo-700 text-2xl svg-text-bg">{data.sideDB}</text>}
                    </svg>
                );
            }

            // --- 9. פיתגורס ---
            if (type.startsWith("pythagoras")) {
                if (type === "pythagoras_multi") {
                    return (
                        <svg viewBox="0 0 320 220" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                            <path d="M 60 180 L 160 180 L 160 40 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <path d="M 160 180 L 260 180 L 160 40 Z" fill="#eef2ff" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <path d="M 145 180 L 145 165 L 160 165" fill="none" stroke={lineStroke} strokeWidth="3" />
                            <path d="M 175 180 L 175 165 L 160 165" fill="none" stroke={lineStroke} strokeWidth="3" />
                            
                            <text x={110} y={205} textAnchor="middle" className="font-bold text-2xl text-slate-700">{data.leg1}</text>
                            <text x={95} y={100} textAnchor="middle" className="font-bold text-2xl text-slate-700">{data.leg2}</text>
                            
                            {/* צלע משותפת */}
                            <text x={160} y={105} textAnchor="middle" className="font-bold text-2xl text-indigo-700 svg-text-bg">{data.shared}</text>
                            
                            {data.showTarget && (
                                <>
                                    <text x={210} y={205} textAnchor="middle" className="font-bold text-2xl text-slate-700">{data.legRight}</text>
                                    <text x={225} y={100} textAnchor="middle" className="font-bold text-3xl text-rose-600 svg-text-bg">{data.hypRight}</text>
                                </>
                            )}

                            <text x={60} y={205} textAnchor="middle" className="font-bold text-xl text-slate-500">A</text>
                            <text x={160} y={215} textAnchor="middle" className="font-bold text-xl text-slate-500">B</text>
                            <text x={260} y={205} textAnchor="middle" className="font-bold text-xl text-slate-500">C</text>
                            <text x={160} y={25} textAnchor="middle" className="font-bold text-xl text-slate-500">D</text>
                        </svg>
                    );
                }
                
                // בסיסי או ניצב
                return (
                    <svg viewBox="0 0 320 200" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                        <path d="M 80 160 L 240 160 L 80 40 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                        <path d="M 80 145 L 95 145 L 95 160" fill="none" stroke={lineStroke} strokeWidth="3" />
                        
                        <text x={80} y={180} textAnchor="middle" className="font-bold text-xl text-slate-500">B</text>
                        <text x={240} y={180} textAnchor="middle" className="font-bold text-xl text-slate-500">C</text>
                        <text x={80} y={20} textAnchor="middle" className="font-bold text-xl text-slate-500">A</text>

                        {type === "pythagoras_basic" && (
                            <>
                                <text x={50} y={100} textAnchor="middle" className="font-bold text-2xl text-slate-700">{data.leg1}</text>
                                <text x={160} y={185} textAnchor="middle" className="font-bold text-2xl text-slate-700">{data.leg2}</text>
                                {data.hyp && <text x={175} y={90} textAnchor="middle" className="font-bold text-3xl text-rose-600 svg-text-bg">{data.hyp}</text>}
                            </>
                        )}
                        {type === "pythagoras_leg" && (
                            <>
                                <text x={160} y={185} textAnchor="middle" className="font-bold text-2xl text-slate-700">{data.leg}</text>
                                <text x={175} y={90} textAnchor="middle" className="font-bold text-2xl text-indigo-700 svg-text-bg">{data.hyp}</text>
                            </>
                        )}
                    </svg>
                );
            }

            // --- 10. חוצי זווית ---
            if (type === "straight_line_bisectors") {
                const OCx = 160 + 130 * Math.cos(-80 * Math.PI/180);
                const OCy = 180 + 130 * Math.sin(-80 * Math.PI/180);
                const OMx = 160 + 130 * Math.cos(-40 * Math.PI/180);
                const OMy = 180 + 130 * Math.sin(-40 * Math.PI/180);
                const ONx = 160 + 130 * Math.cos(-130 * Math.PI/180);
                const ONy = 180 + 130 * Math.sin(-130 * Math.PI/180);

                return (
                    <svg viewBox="0 0 320 240" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                        <line x1="20" y1="180" x2="300" y2="180" stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <text x="15" y="198" className="font-bold text-xl">A</text> 
                        <text x="153" y="198" className="font-bold text-xl">O</text> 
                        <text x="295" y="198" className="font-bold text-xl">B</text>
                        
                        <line x1="160" y1="180" x2={OCx} y2={OCy} stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <text x={160 + 148 * Math.cos(-80 * Math.PI/180)} y={180 + 148 * Math.sin(-80 * Math.PI/180)} className="font-bold text-xl">C</text>
                        
                        <line x1="160" y1="180" x2={OMx} y2={OMy} stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <text x={160 + 148 * Math.cos(-40 * Math.PI/180)} y={180 + 148 * Math.sin(-40 * Math.PI/180)} className="font-bold text-xl">M</text>

                        <line x1="160" y1="180" x2={ONx} y2={ONy} stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <text x={160 + 148 * Math.cos(-130 * Math.PI/180)} y={180 + 148 * Math.sin(-130 * Math.PI/180)} className="font-bold text-xl">N</text>

                        <AngleArc cx={160} cy={180} startAngle={280} endAngle={320} radius={50} label="40°" color="#0d9488" labelX={205} labelY={150} />
                        <AngleArc cx={160} cy={180} startAngle={230} endAngle={280} radius={55} label="x°" color="#e11d48" labelX={130} labelY={130} />
                    </svg>
                );
            }

            if (type === "intersecting_x_y") {
                return (
                    <svg viewBox="0 0 320 240" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                        <line x1="40" y1="130" x2="280" y2="70" stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <text x="30" y="145" className="font-bold text-xl">R</text>
                        <text x="290" y="65" className="font-bold text-xl">S</text>

                        <line x1="70" y1="60" x2="250" y2="140" stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <text x="60" y="55" className="font-bold text-xl">P</text>
                        <text x="260" y="155" className="font-bold text-xl">M</text>

                        <AngleArc cx={160} cy={100} startAngle={204} endAngle={346} radius={45} label="150°" color="#0f172a" labelOffset={18} />
                        <AngleArc cx={160} cy={100} startAngle={166} endAngle={204} radius={40} label="x°" color="#e11d48" />
                        <AngleArc cx={160} cy={100} startAngle={346} endAngle={384} radius={40} label="y°" color="#0d9488" />
                    </svg>
                );
            }

            if (type === "congruence_algebra") {
                const t1 = { A:{x:60, y:50}, B:{x:60, y:150}, C:{x:140, y:150} };
                const t2 = { D:{x:200, y:50}, E:{x:200, y:150}, F:{x:280, y:150} };
                return (
                    <svg viewBox="0 0 320 240" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                        <path d={`M${t1.A.x},${t1.A.y} L${t1.B.x},${t1.B.y} L${t1.C.x},${t1.C.y} Z`} fill="#f0fdf4" stroke={lineStroke} strokeWidth={strokeW} />
                        <path d={`M${t2.D.x},${t2.D.y} L${t2.E.x},${t2.E.y} L${t2.F.x},${t2.F.y} Z`} fill="#f0fdf4" stroke={lineStroke} strokeWidth={strokeW} />
                        <text x={40} y={100} className="font-bold fill-rose-600 svg-text-bg text-xl">{data.l1}</text>
                        <text x={180} y={100} className="font-bold fill-indigo-600 svg-text-bg text-xl">{data.l2}</text>
                        <TickMark p1={t1.A} p2={t1.B} count={1} />
                        <TickMark p1={t2.D} p2={t2.E} count={1} />
                    </svg>
                );
            }

            // --- 11. טקסט בלבד ---
            if (type === "text_only") {
                return (
                    <div className="flex items-center justify-center h-80 w-full bg-slate-50/50 rounded-3xl">
                        <span className="text-9xl text-indigo-100 font-bold select-none drop-shadow-sm">?</span>
                    </div>
                );
            }

            return null;
        };

        function App() {
            const [currentQuestion, setCurrentQuestion] = useState(0);
            const [score, setScore] = useState(0);
            const [showFeedback, setShowFeedback] = useState(false);
            const [isCorrect, setIsCorrect] = useState(false);
            const [selectedOption, setSelectedOption] = useState(null);

            const handleOptionClick = (index) => {
                if (showFeedback) return;
                setSelectedOption(index);
                const correct = index === QUESTIONS[currentQuestion].correct;
                setIsCorrect(correct);
                setShowFeedback(true);
                if (correct) setScore(score + 1);
            };

            const nextQuestion = () => {
                setShowFeedback(false);
                setSelectedOption(null);
                setCurrentQuestion(currentQuestion + 1);
            };

            const prevQuestion = () => {
                if (currentQuestion > 0) {
                    setShowFeedback(false);
                    setSelectedOption(null);
                    setCurrentQuestion(currentQuestion - 1);
                }
            };

            const restartQuiz = () => {
                setScore(0);
                setCurrentQuestion(0);
                setShowFeedback(false);
                setSelectedOption(null);
            };

            if (currentQuestion >= QUESTIONS.length) {
                return (
                    <div className="max-w-[1000px] mx-auto p-8 flex flex-col items-center justify-center min-h-screen animate-fade-in" dir="rtl">
                        <div className="bg-white/90 backdrop-blur p-12 rounded-3xl shadow-2xl w-full text-center border-t-8 border-indigo-600">
                            <Trophy className="w-28 h-28 text-yellow-500 mx-auto mb-8 drop-shadow-lg" />
                            <h1 className="text-6xl font-black text-slate-800 mb-6">אלופים! סיימתם!</h1>
                            <p className="text-3xl text-slate-600 mb-10 font-medium">
                                עניתם נכונה על <span className="text-indigo-600 font-bold">{score}</span> מתוך <span className="font-bold">{QUESTIONS.length}</span> שאלות.
                            </p>
                            
                            <div className="w-full bg-gray-200 rounded-full h-5 mb-10 overflow-hidden">
                                <div className="bg-gradient-to-r from-indigo-500 to-purple-600 h-5 rounded-full transition-all duration-1000" style={{ width: `${(score / QUESTIONS.length) * 100}%` }}></div>
                            </div>

                            <button onClick={restartQuiz} className="bg-indigo-600 hover:bg-indigo-700 text-white text-3xl font-bold py-5 px-12 rounded-2xl shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-1 flex items-center justify-center gap-4 mx-auto">
                                <RefreshCw size={32} /> נסו שוב
                            </button>
                        </div>
                    </div>
                );
            }

            const q = QUESTIONS[currentQuestion];
            const progressPct = ((currentQuestion) / QUESTIONS.length) * 100;

            return (
                <div className="max-w-[1000px] mx-auto p-4 md:p-8" dir="rtl">
                    <div className="w-full mb-8">
                        <div className="flex justify-between items-end mb-3 px-2">
                            <span className="text-2xl font-bold text-indigo-900">שאלה {currentQuestion + 1} מתוך {QUESTIONS.length}</span>
                            <span className="text-2xl font-bold text-emerald-700 bg-emerald-100 px-5 py-2 rounded-full shadow-sm">הניקוד שלך: {score}</span>
                        </div>
                        <div className="w-full bg-slate-200 rounded-full h-4 shadow-inner overflow-hidden">
                            <div className="bg-indigo-600 h-4 rounded-full transition-all duration-500 ease-out" style={{ width: `${progressPct}%` }}></div>
                        </div>
                    </div>

                    <div className="bg-white rounded-3xl shadow-2xl overflow-hidden w-full border border-slate-100 animate-fade-in relative pb-20 md:pb-24">
                        <div className="bg-indigo-50/40 p-4 md:p-8 flex justify-center border-b border-slate-100 min-h-[380px] items-center relative">
                            <GeometryDiagram type={q.type} data={q.diagramData} />
                        </div>

                        <div className="p-6 md:p-10">
                            <h2 className="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center leading-snug">
                                {q.text}
                            </h2>

                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-8">
                                {q.options.map((option, index) => {
                                    let btnClass = "text-xl md:text-2xl font-bold py-5 px-6 rounded-2xl border-[3px] transition-all duration-200 shadow-sm text-center transform hover:scale-[1.02] active:scale-[0.98] ";
                                    if (showFeedback) {
                                        if (index === q.correct) btnClass += "bg-emerald-50 border-emerald-500 text-emerald-700 z-10";
                                        else if (index === selectedOption) btnClass += "bg-rose-50 border-rose-500 text-rose-700 z-10";
                                        else btnClass += "bg-slate-50 border-slate-100 text-slate-400 opacity-50";
                                    } else {
                                        btnClass += "bg-slate-50 border-transparent text-slate-700 hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-900 shadow-[0_4px_14px_rgba(0,0,0,0.05)]";
                                    }
                                    return (
                                        <button key={index} onClick={() => handleOptionClick(index)} disabled={showFeedback} className={btnClass}>
                                            <span dir="ltr" className="inline-block">{option}</span>
                                        </button>
                                    );
                                })}
                            </div>

                            {showFeedback && (
                                <div className={`rounded-3xl p-6 md:p-8 mt-6 animate-fade-in ${isCorrect ? 'bg-emerald-50 border-4 border-emerald-200' : 'bg-rose-50 border-4 border-rose-200'}`}>
                                    <div className="flex items-center gap-4 mb-4">
                                        {isCorrect ? <Check className="text-emerald-600" /> : <X className="text-rose-600" />}
                                        <h3 className={`text-2xl md:text-3xl font-black ${isCorrect ? 'text-emerald-800' : 'text-rose-800'}`}>
                                            {isCorrect ? 'תשובה נכונה, מעולה!' : 'לא נורא, טעות קטנה'}
                                        </h3>
                                    </div>
                                    <p className="text-xl md:text-2xl text-slate-700 font-medium leading-relaxed">{q.explanation}</p>
                                </div>
                            )}
                        </div>

                        {/* Navigation Footer */}
                        <div className="absolute bottom-0 left-0 right-0 p-6 md:p-8 flex justify-between items-center bg-slate-50 border-t border-slate-100">
                            <button 
                                onClick={prevQuestion} 
                                disabled={currentQuestion === 0} 
                                className="px-5 py-3 md:px-6 md:py-4 bg-white border-2 border-slate-200 hover:border-slate-300 hover:bg-slate-100 text-slate-600 font-bold rounded-xl transition-all disabled:opacity-40 disabled:hover:bg-white disabled:hover:border-slate-200 flex items-center gap-2 text-lg"
                            >
                                <ArrowRight className="rotate-180" size={24} /> <span>שאלה קודמת</span>
                            </button>
                            
                            <button 
                                onClick={nextQuestion} 
                                className="px-6 py-3 md:px-8 md:py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 flex items-center gap-2 text-lg md:text-xl"
                            >
                                <span>{currentQuestion === QUESTIONS.length - 1 ? 'לסיום' : 'שאלה הבאה'}</span> <ArrowRight size={24} />
                            </button>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
