                            </>
                        )}
                        {type === "intersecting_linear" && (
                            <>
                                <AngleArc cx={cx} cy={cy} startAngle={180} endAngle={315} radius={40} label={data.angle1} color="#e11d48" />
                                <AngleArc cx={cx} cy={cy} startAngle={315} endAngle={360} radius={45} label="" color="#0d9488" />
                            </>
                        )}
                    </svg>
                );
            }

            // --- 2. מקבילים ---
            if (type.startsWith("parallel")) {
                const y1 = 70, y2 = 160;
                const p1 = {x: 130, y: 70}, p2 = {x: 205, y: 160};
                return (
                    <svg viewBox="0 0 320 240" className="w-full h-80 mx-auto select-none drop-shadow-sm">
