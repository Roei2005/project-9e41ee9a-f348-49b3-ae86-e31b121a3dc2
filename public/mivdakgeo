                        <text x={t2.E.x-15} y={t2.E.y+15} textAnchor="middle" className="font-bold text-xl fill-slate-700">E</text>
                        <text x={t2.F.x+15} y={t2.F.y+15} textAnchor="middle" className="font-bold text-xl fill-slate-700">F</text>
                        
                        {type === "congruence_sas" && (
                            <>
                                <TickMark p1={t1.A} p2={t1.B} count={1} color="#ef4444" />
                                <TickMark p1={t2.D} p2={t2.E} count={1} color="#ef4444" />
