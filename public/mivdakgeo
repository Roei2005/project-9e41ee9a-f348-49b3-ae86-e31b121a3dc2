                        <path d={`M${B.x},${B.y} L${D.x},${D.y}`} stroke={lineStroke} strokeWidth={strokeW} />
                        
                        {type === "hourglass_areas" ? (
                            <>
                                <text x={A.x} y={A.y-15} textAnchor="middle" className="font-bold text-xl">A</text>
                                <text x={B.x} y={B.y-15} textAnchor="middle" className="font-bold text-xl">B</text>
                                <text x={D.x} y={D.y+25} textAnchor="middle" className="font-bold text-xl">D</text>
                                <text x={E.x} y={E.y+25} textAnchor="middle" className="font-bold text-xl">C</text>
                                <text x={C.x} y={C.y-15} textAnchor="middle" className="font-bold text-xl">E</text>
                                <text x={160} y={40} textAnchor="middle" className="font-bold text-xl fill-indigo-700">6</text>
                                <text x={160} y={215} textAnchor="middle" className="font-bold text-xl fill-indigo-700">24</text>
