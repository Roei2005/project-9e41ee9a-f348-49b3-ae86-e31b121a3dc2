                        <text x="305" y={y1+5} className="font-bold fill-slate-400 text-xl">a</text>
                        <line x1="20" y1={y2} x2="300" y2={y2} stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <text x="305" y={y2+5} className="font-bold fill-slate-400 text-xl">b</text>
                        <line x1="80" y1="10" x2="230" y2="190" stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        
                        {type === "parallel_alternate" && (
                            <>
                                <AngleArc cx={p1.x} cy={p1.y} startAngle={180} endAngle={230} radius={40} label={data.val1} color="#e11d48" labelOffset={25} />
                                <AngleArc cx={p2.x} cy={p2.y} startAngle={0} endAngle={50} radius={40} label="" color="#0d9488" />
                            </>
