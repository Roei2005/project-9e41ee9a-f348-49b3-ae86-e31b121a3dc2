                                <TickMark p1={t2.E} p2={t2.F} count={2} color="#3b82f6" />
                                <AngleArc cx={t1.B.x} cy={t1.B.y} startAngle={-74.7} endAngle={0} radius={25} color="#f59e0b" label="" />
                                <AngleArc cx={t2.E.x} cy={t2.E.y} startAngle={-74.7} endAngle={0} radius={25} color="#f59e0b" label="" />
                            </>
                        )}
                        {type === "congruence_sss" && (
                            <>
                                <TickMark p1={t1.A} p2={t1.B} count={1} /> <TickMark p1={t2.D} p2={t2.E} count={1} />
                                <TickMark p1={t1.B} p2={t1.C} count={2} color="#3b82f6" /> <TickMark p1={t2.E} p2={t2.F} count={2} color="#3b82f6" />
