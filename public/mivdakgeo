                        <TickMark p1={top} p2={right} count={1} />

                        {(type.includes("altitude") || type.includes("median")) && (
                            <>
                                <line x1={top.x} y1={top.y} x2={160} y2={190} stroke={lineStroke} strokeDasharray="6,6" strokeWidth="2.5" />
                                {type === "isosceles_median_angle" ? (
                                    <>
                                        <AngleArc cx={160} cy={190} startAngle={180} endAngle={270} radius={25} color="#e11d48" label="" />
