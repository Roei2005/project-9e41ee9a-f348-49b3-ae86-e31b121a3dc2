            // --- 7. שעון חול (Hourglass) אלגברה ודמיון ---
            if (type.startsWith("hourglass")) {
                const A = {x: 80, y: 50}, B = {x: 240, y: 50}, D = {x: 80, y: 190}, E = {x: 240, y: 190}, C = {x: 160, y: 120};
                return (
                    <svg viewBox="0 0 320 240" className="w-full h-80 mx-auto select-none drop-shadow-md">
                        <line x1="40" y1="50" x2="280" y2="50" stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                        <line x1="40" y1="190" x2="280" y2="190" stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
