                        {type === "isosceles_parallel" && (
                            <>
                                <line x1={100} y1={136} x2={220} y2={136} stroke={lineStroke} strokeWidth="3" strokeLinecap="round" />
                                <text x={85} y={136} textAnchor="middle" className="font-bold text-xl">D</text>
                                <text x={235} y={136} textAnchor="middle" className="font-bold text-xl">E</text>
                                <AngleArc cx={top.x} cy={top.y} startAngle={58} endAngle={122} radius={45} label={data.valA} color="#10b981" labelX={160} labelY={100} />
