                                {type === "hourglass_algebra" && (
                                    <>
                                        <AngleArc cx={A.x} cy={A.y} startAngle={0} endAngle={41.2} radius={50} label={data.valA} color="#e11d48" labelX={145} labelY={80} />
                                        <AngleArc cx={E.x} cy={E.y} startAngle={180} endAngle={221.2} radius={50} label={data.valE} color="#0d9488" labelX={175} labelY={160} />
