                        <AngleArc cx={B.x} cy={B.y} startAngle={35} endAngle={54.5} radius={85} label={data.valDAC} color="#e11d48" labelX={105} labelY={120} />
                        <AngleArc cx={160} cy={190} startAngle={180} endAngle={234.5} radius={45} label={data.valADB} color="#0d9488" labelX={128} labelY={170} />
                    </svg>
