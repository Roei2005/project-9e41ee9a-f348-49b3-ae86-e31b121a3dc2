        // Component to cleanly draw SVG arcs with manual position overrides
        const AngleArc = ({ cx, cy, startAngle, endAngle, radius, label, color="#4f46e5", labelX=null, labelY=null, labelOffset=25 }) => {
            const toRad = (deg) => (deg * Math.PI) / 180;
            const x1 = cx + radius * Math.cos(toRad(startAngle));
            const y1 = cy + radius * Math.sin(toRad(startAngle));
            const x2 = cx + radius * Math.cos(toRad(endAngle));
            const y2 = cy + radius * Math.sin(toRad(endAngle));
            
            let sweep = endAngle - startAngle;
            if (sweep < 0) sweep += 360;
            const largeArcFlag = sweep > 180 ? 1 : 0;
            const d = `M ${x1} ${y1} A ${radius} ${radius} 0 ${largeArcFlag} 1 ${x2} ${y2}`;
            
            const midAngle = startAngle + (sweep / 2);
            const labelR = radius + labelOffset; 
            const lx = labelX !== null ? labelX : cx + labelR * Math.cos(toRad(midAngle));
            const ly = labelY !== null ? labelY : cy + labelR * Math.sin(toRad(midAngle));

            return (
                <g>
                    <path d={d} fill="none" stroke={color} strokeWidth="3.5" strokeLinecap="round" />
                    {label && (
                        <text x={lx} y={ly} textAnchor="middle" dominantBaseline="middle" className="font-bold fill-indigo-900 svg-text-bg" style={{ fontSize: "19px" }}>
                            {label}
                        </text>
                    )}
                </g>
            );
        };

        const TickMark = ({ p1, p2, count=1, color="#10b981" }) => {
            const midX = (p1.x + p2.x) / 2;
            const midY = (p1.y + p2.y) / 2;
            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const len = Math.sqrt(dx*dx + dy*dy);
            const nx = -dy / len;
            const ny = dx / len;
            const size = 8;
            const gap = 6;
            const startOffset = -((count - 1) * gap) / 2;
            
            const lines = [];
            for(let i=0; i<count; i++) {
                const off = startOffset + i*gap;
                const cx = midX + (dx/len)*off;
                const cy = midY + (dy/len)*off;
                lines.push(
                    <line key={i} x1={cx - nx*size} y1={cy - ny*size} x2={cx + nx*size} y2={cy + ny*size} stroke={color} strokeWidth="3" strokeLinecap="round" />
                );
            }
            return <g>{lines}</g>;
        };

        const GeometryDiagram = ({ type, data }) => {
            const lineStroke = "#334155"; 
            const strokeW = "3.5";

