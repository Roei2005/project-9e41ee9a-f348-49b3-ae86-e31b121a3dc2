                        {type === "isosceles_altitude_side" && (
                            <>
                                <path d="M 80 235 L 80 245 L 240 245 L 240 235" fill="none" stroke="#3b82f6" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" />
