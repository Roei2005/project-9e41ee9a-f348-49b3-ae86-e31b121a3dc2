                        <text x={right.x+15} y={right.y+15} textAnchor="middle" className="font-bold fill-slate-800 text-xl">C</text>

                        {type === "isosceles_base_calc" && (
                            <>
                                <AngleArc cx={top.x} cy={top.y} startAngle={63.4} endAngle={116.6} radius={40} label={data.topLabel} color="#e11d48" />
                                <AngleArc cx={right.x} cy={right.y} startAngle={180} endAngle={243.4} radius={40} label="" color="#0d9488" />
                            </>
                        )}
                        {type === "isosceles_ext_calc" && (
                            <>
                                <line x1={right.x} y1={right.y} x2={300} y2={190} stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                                <AngleArc cx={right.x} cy={right.y} startAngle={180} endAngle={243.4} radius={35} label={data.baseVal} color="#0d9488" />
                                <AngleArc cx={right.x} cy={right.y} startAngle={243.4} endAngle={360} radius={35} label="" color="#e11d48" />
                            </>
                        )}
                        {type === "isosceles_altitude_angle" && (
                            <>
                                <AngleArc cx={top.x} cy={top.y} startAngle={63.4} endAngle={116.6} radius={50} label={data.angleA_Full} color="#0f172a" labelOffset={30} />
                            </>
