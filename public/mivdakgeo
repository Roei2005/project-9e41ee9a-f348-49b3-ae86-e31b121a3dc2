                            </>
                        )}
                    </svg>
                );
            }

            // --- 8. דמיון משולשים חדשים ---
            if (type.startsWith("sim_trick")) {
                if (type === "sim_trick") {
                    return (
                        <svg viewBox="0 0 320 180" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                            <path d="M 60 40 L 20 160 L 120 160 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <AngleArc cx={60} cy={40} startAngle={71.5} endAngle={108.4} radius={40} label="46°" color="#0d9488" labelX={60} labelY={95} />
                            <AngleArc cx={120} cy={160} startAngle={180} endAngle={251.5} radius={35} label="54°" color="#e11d48" labelX={85} labelY={145} />
                            
                            <path d="M 220 40 L 170 160 L 290 160 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <AngleArc cx={220} cy={40} startAngle={67.4} endAngle={112.6} radius={40} label="46°" color="#0d9488" labelX={220} labelY={95} />
                            <AngleArc cx={170} cy={160} startAngle={292.6} endAngle={360} radius={35} label="80°" color="#f59e0b" labelX={210} labelY={145} />
                        </svg>
                    );
                }
                if (type === "sim_trick_2") {
                    return (
                        <svg viewBox="0 0 320 180" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                            <path d="M 40 40 L 40 160 L 100 160 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <path d="M 40 145 L 55 145 L 55 160" fill="none" stroke={lineStroke} strokeWidth="3" />
                            <AngleArc cx={40} cy={40} startAngle={63.4} endAngle={90} radius={45} label="24°" color="#0d9488" labelX={55} labelY={95} />

                            <path d="M 180 160 L 280 160 L 280 40 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <path d="M 265 160 L 265 145 L 280 145" fill="none" stroke={lineStroke} strokeWidth="3" />
                            <line x1={180} y1={160} x2={140} y2={160} stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                            <AngleArc cx={180} cy={160} startAngle={180} endAngle={309.8} radius={35} label="114°" color="#e11d48" labelX={155} labelY={125} />
                        </svg>
                    );
                }
                if (type === "sim_trick_3") {
                    return (
                        <svg viewBox="0 0 320 180" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                            <path d="M 20 40 L 40 160 L 160 160 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <AngleArc cx={20} cy={40} startAngle={0} endAngle={80.5} radius={30} label="26°" color="#0d9488" labelX={40} labelY={85} />
                            <AngleArc cx={40} cy={160} startAngle={260.5} endAngle={360} radius={25} label="y+54" color="#e11d48" labelX={70} labelY={140} />
                            <AngleArc cx={160} cy={160} startAngle={180} endAngle={218.6} radius={40} label="y" color="#f59e0b" labelX={115} labelY={150} />

                            <path d="M 280 20 L 200 160 L 280 160 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <AngleArc cx={280} cy={20} startAngle={90} endAngle={119.7} radius={45} label="x" color="#0d9488" labelX={265} labelY={75} />
                            <AngleArc cx={200} cy={160} startAngle={299.7} endAngle={360} radius={35} label="50°" color="#e11d48" labelX={235} labelY={145} />
                            <AngleArc cx={280} cy={160} startAngle={180} endAngle={270} radius={25} label="4x" color="#f59e0b" labelX={260} labelY={135} />
                        </svg>
                    );
                }
            }

            if (type === "sim_nested" || type === "sim_perimeters") {
                const A = {x:160, y:30}, B = {x:60, y:200}, C = {x:260, y:200};
                const D = {x:120, y:98}, E = {x:200, y:98};
                
                if (type === "sim_perimeters") {
                    return (
                        <svg viewBox="0 0 320 220" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                            <path d="M 60 180 L 100 80 L 140 180 Z" fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <path d="M 180 180 L 240 30 L 300 180 Z" fill="#eef2ff" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                            <text x={100} y={150} className="font-bold text-indigo-700 text-xl">P=12</text>
