                            <>
                                <text x={A.x} y={A.y-15} textAnchor="middle" className="font-bold text-xl">A</text>
                                <text x={B.x} y={B.y-15} textAnchor="middle" className="font-bold text-xl">B</text>
                                <text x={D.x} y={D.y+25} textAnchor="middle" className="font-bold text-xl">D</text>
                                <text x={E.x} y={E.y+25} textAnchor="middle" className="font-bold text-xl">E</text>
                                <text x={C.x+20} y={C.y} textAnchor="middle" className="font-bold text-xl">C</text>
                                
                                {type === "hourglass_angles_basic" && (
                                    <>
                                        <AngleArc cx={A.x} cy={A.y} startAngle={0} endAngle={41.2} radius={45} label={data.valA} color="#e11d48" labelX={130} labelY={75} />
                                        <AngleArc cx={B.x} cy={B.y} startAngle={138.8} endAngle={180} radius={45} label={data.valB} color="#0d9488" labelX={190} labelY={75} />
