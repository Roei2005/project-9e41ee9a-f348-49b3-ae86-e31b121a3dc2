                            <line x1="180" y1="60" x2="40" y2="60" stroke={lineStroke} strokeWidth={strokeW} strokeLinecap="round" />
                            <text x="30" y="65" className="font-bold text-xl">E</text>
                            <text x="195" y="50" className="font-bold text-xl">A</text>
                            <text x="65" y="215" className="font-bold text-xl">B</text>
                            <text x="275" y="215" className="font-bold text-xl">C</text>
                            <AngleArc cx={leftP.x} cy={leftP.y} startAngle={305} endAngle={360} radius={45} label="75°" color="#e11d48" labelX={125} labelY={182} />
                            <AngleArc cx={topP.x} cy={topP.y} startAngle={180} endAngle={234} radius={50} label="50°" color="#0d9488" labelX={135} labelY={85} />
                        </svg>
