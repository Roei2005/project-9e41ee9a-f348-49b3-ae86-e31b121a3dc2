                return (
                    <svg viewBox="0 0 320 260" className="w-full h-80 mx-auto select-none drop-shadow-md">
                        <path d={`M${top.x},${top.y} L${right.x},${right.y} L${left.x},${left.y} Z`} fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                        <text x={top.x} y={top.y-12} textAnchor="middle" className="font-bold text-xl">A</text>
                        <text x={left.x-15} y={left.y+15} textAnchor="middle" className="font-bold text-xl">B</text>
                        <text x={right.x+15} y={right.y+15} textAnchor="middle" className="font-bold text-xl">C</text>
                        
                        {type === "isosceles_internal" && (
