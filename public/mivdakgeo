                }

                return (
                    <svg viewBox="0 0 320 240" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                        <path d={`M${A.x},${A.y} L${B.x},${B.y} L${C.x},${C.y} Z`} fill="#f8fafc" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
