            }

            // --- 6. משולש שוו"ש עם קו פנימי / צלע מקבילה ---
            if (type === "isosceles_internal" || type === "triangle_parallel_ray" || type === "isosceles_parallel") {
                const top = {x: 160, y: 40}, left = {x: 60, y: 200}, right = {x: 260, y: 200};
                
                if (type === "triangle_parallel_ray") {
