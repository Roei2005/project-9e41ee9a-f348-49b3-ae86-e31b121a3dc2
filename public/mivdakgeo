            }

            // --- 4. חפיפה פשוטה ---
            if (type.startsWith("congruence") && !type.includes("algebra")) {
                const t1 = { A:{x:60, y:40}, B:{x:30, y:150}, C:{x:100, y:150} };
                const t2 = { D:{x:220, y:40}, E:{x:190, y:150}, F:{x:260, y:150} };
                return (
                    <svg viewBox="0 0 320 220" className="w-full h-80 mx-auto select-none drop-shadow-sm">
                        <path d={`M${t1.A.x},${t1.A.y} L${t1.B.x},${t1.B.y} L${t1.C.x},${t1.C.y} Z`} fill="#f0fdf4" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
                        <path d={`M${t2.D.x},${t2.D.y} L${t2.E.x},${t2.E.y} L${t2.F.x},${t2.F.y} Z`} fill="#f0fdf4" stroke={lineStroke} strokeWidth={strokeW} strokeLinejoin="round" />
