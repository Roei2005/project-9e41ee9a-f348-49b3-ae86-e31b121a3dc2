                    question: 'בחידון תנ"ך יש שני שלבים.\nכדי להעפיל לשלב השני יש לענות נכון לפחות על 70% מהשאלות.\nבשלב א\' היו 24 שאלות.\n\nרן ענה נכון על 14 שאלות.\nדני ענה נכון על 18 שאלות.\nגד ענה נכון על 15 שאלות.\nאיתי ענה נכון על 20 שאלות.\n\nמי מהילדים עלה לשלב הבא? נמקו את תשובתכם.',
                    trick: (
                        <div className="text-3xl space-y-6 leading-loose">
                            <p>במקום לנחש, בואו נחשב במדויק מהו "רף המעבר" לשלב הבא!</p>
                            <p className="bg-yellow-100 p-8 rounded-3xl shadow-sm border-4 border-yellow-300 text-yellow-900 font-bold">
                                נחשב כמה שאלות הן בדיוק <PerFrom pct="70" num="24" />. מי שענה על מספר כזה של שאלות (או יותר) – עבר. מי שענה פחות – לא עבר.
                            </p>
                        </div>
                    ),
                    solution: (
                        <div className="text-3xl space-y-8 leading-loose">
                            <div className="bg-white p-8 rounded-3xl shadow-sm border-2 border-slate-200">
                                <h3 className="font-black text-4xl text-indigo-600 mb-6 border-b-2 pb-4">שלב 1: חישוב רף המעבר</h3>
                                <p>נחשב <PerFrom pct="70" num="24" />:</p>
                                <ul className="list-disc list-inside space-y-2 font-bold ml-6 mt-4 mb-6">
                                    <li><PerFrom pct="10" num="24" /> הם 2.4.</li>
                                    <li>לכן 70% הם פי 7: <MathLtr>2.4 × 7 = 16.8</MathLtr></li>
                                </ul>
                                <div className="font-mono text-center text-5xl my-6 font-black text-slate-700 bg-slate-50 py-4 rounded-xl border border-slate-200 w-fit mx-auto px-10 shadow-inner" dir="ltr">16.8</div>
                                <p className="font-bold text-red-600 bg-red-50 p-6 rounded-2xl text-center border-2 border-red-200 mt-4">
                                    מכיוון שאי אפשר לענות על "0.8 שאלה", ילד חייב לענות נכון על <strong className="text-4xl underline decoration-4 mx-2">לפחות 17 שאלות</strong> כדי לעבור!
                                </p>
                            </div>

                            <div className="bg-white p-8 rounded-3xl shadow-sm border-2 border-slate-200">
                                <h3 className="font-black text-4xl text-indigo-600 mb-6 border-b-2 pb-4">שלב 2: מי עבר?</h3>
                                <div className="grid md:grid-cols-2 gap-6 text-4xl font-bold">
                                    <div className="bg-red-50 p-6 rounded-2xl border-4 border-red-200 flex flex-col justify-center items-center text-center gap-4">
                                        <span className="text-slate-700">רן (14)</span>
                                        <span className="text-red-600 font-black bg-white px-6 py-2 rounded-xl shadow-sm text-3xl">לא עבר ❌</span>
                                    </div>
                                    <div className="bg-emerald-50 p-6 rounded-2xl border-4 border-emerald-200 flex flex-col justify-center items-center text-center gap-4">
                                        <span className="text-slate-700">דני (18)</span>
                                        <span className="text-emerald-600 font-black bg-white px-6 py-2 rounded-xl shadow-sm text-3xl">עבר! ✅</span>
                                    </div>
                                    <div className="bg-red-50 p-6 rounded-2xl border-4 border-red-200 flex flex-col justify-center items-center text-center gap-4">
                                        <span className="text-slate-700">גד (15)</span>
                                        <span className="text-red-600 font-black bg-white px-6 py-2 rounded-xl shadow-sm text-3xl">לא עבר ❌</span>
                                    </div>
                                    <div className="bg-emerald-50 p-6 rounded-2xl border-4 border-emerald-200 flex flex-col justify-center items-center text-center gap-4">
                                        <span className="text-slate-700">איתי (20)</span>
                                        <span className="text-emerald-600 font-black bg-white px-6 py-2 rounded-xl shadow-sm text-3xl">עבר! ✅</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div className="bg-indigo-50 p-8 rounded-3xl border-4 border-indigo-200 mt-10 shadow-inner text-center">
                                <p className="text-5xl font-black text-indigo-600 bg-white p-6 rounded-2xl shadow-md border-2 border-indigo-100 inline-block w-full">רק דני ואיתי עלו לשלב הבא!</p>
                            </div>
                        </div>
                    )
                }
            ];

            const handleSelect = (id) => {
                setActiveId(id);
                setStep(0);
            };

            if (!activeId) {
                return (
                    <div className="max-w-6xl mx-auto fade-in">
                        <h2 className="text-5xl md:text-6xl font-black text-center text-slate-800 mb-6">שאלות מילוליות לכיתה 📚</h2>
                        <p className="text-3xl text-center text-slate-500 mb-12">השאלות הקשות ביותר הופכות קלות עם טריקים!</p>
                        
                        <div className="grid md:grid-cols-2 gap-8">
                            {wordProblems.map((p, i) => (
                                <button 
                                    key={p.id} 
                                    onClick={() => handleSelect(p.id)}
                                    className={`bg-white p-10 rounded-[3rem] shadow-lg border-4 transition-all group text-right flex flex-col justify-between min-h-[250px] relative overflow-hidden ${p.title.includes('🔥') ? 'border-amber-300 hover:border-amber-500 hover:shadow-amber-200/50' : 'border-transparent hover:border-indigo-400'} hover:shadow-2xl`}
                                >
                                    <div className={`absolute -top-4 -left-4 w-24 h-24 rounded-full group-hover:scale-[2] transition-transform duration-500 z-0 ${p.title.includes('🔥') ? 'bg-amber-50' : 'bg-indigo-50'}`}></div>
                                    <div className="relative z-10">
                                        <div className="flex justify-between items-center mb-6">
                                            <span className={`${p.title.includes('🔥') ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-indigo-100 text-indigo-800'} font-black px-6 py-2 rounded-2xl text-2xl shadow-sm`}>{p.title}</span>
                                            <span className="text-slate-300 group-hover:text-indigo-400 transition-colors scale-150">{icons.board}</span>
                                        </div>
                                        <h3 className="text-3xl font-bold text-slate-800 mb-4 leading-tight whitespace-pre-wrap line-clamp-3">{p.question.split('\n')[0]}...</h3>
                                    </div>
                                    <div className={`relative z-10 text-2xl font-bold flex items-center gap-3 mt-6 ${p.title.includes('🔥') ? 'text-amber-700' : 'text-indigo-600'}`}>
                                        לפתרון מודרך בשלבים <span className="text-3xl transition-transform group-hover:-translate-x-3">←</span>
                                    </div>
                                </button>
                            ))}
                        </div>
                    </div>
                );
            }

            const activeProblem = wordProblems.find(p => p.id === activeId);

            return (
                <div className="max-w-6xl mx-auto fade-in slide-up pb-20">
                    <button onClick={() => setActiveId(null)} className="mb-10 text-3xl font-bold text-slate-500 hover:text-indigo-600 flex items-center gap-3 bg-white px-8 py-4 rounded-full shadow-md hover:shadow-lg transition-all w-fit border-2 border-slate-100">
                        ➜ חזרה לרשימת השאלות
                    </button>

                    <div className="glass-card rounded-[4rem] overflow-hidden p-10 md:p-16 relative shadow-2xl border-4 border-indigo-50">
                        <div className="mb-12">
                            <h2 className="text-4xl text-indigo-500 font-black mb-8 inline-block bg-indigo-50 px-6 py-2 rounded-2xl border-2 border-indigo-100">{activeProblem.title}</h2>
                            <h1 className="text-3xl md:text-4xl font-bold text-slate-800 leading-loose whitespace-pre-wrap bg-white p-8 rounded-3xl shadow-sm border border-slate-100">{activeProblem.question}</h1>
                        </div>

                        {activeProblem.options && step === 0 && (
                            <div className="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
                                {activeProblem.options.map((opt, i) => (
                                    <div key={i} className="bg-slate-50 text-center p-8 rounded-3xl text-4xl font-mono font-black text-slate-600 border-4 border-slate-200 shadow-sm hover:border-indigo-300 transition-colors">
                                        {opt}
                                    </div>
                                ))}
                            </div>
                        )}

                        <div className="flex flex-col sm:flex-row gap-8 border-t-4 border-slate-100 pt-12">
                            {step < 1 && (
                                <button onClick={() => setStep(1)} className="flex-1 bg-gradient-to-r from-yellow-300 to-yellow-400 hover:from-yellow-400 hover:to-yellow-500 text-yellow-900 text-4xl font-black py-8 rounded-[2rem] shadow-xl transition-transform hover:-translate-y-2 flex items-center justify-center gap-4">
                                    {icons.bulb} גלה לי טריק לחשיבה!
                                </button>
                            )}
                            
                            {step >= 1 && step < 2 && (
                                <button onClick={() => setStep(2)} className="flex-1 bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-500 hover:to-emerald-600 text-white text-4xl font-black py-8 rounded-[2rem] shadow-xl transition-transform hover:-translate-y-2 flex items-center justify-center gap-4 fade-in">
                                    {icons.check} הצג פתרון מלא
                                </button>
                            )}
                        </div>

                        {step >= 1 && (
                            <div className="mt-12 bg-yellow-50 border-[6px] border-yellow-300 rounded-[3rem] p-10 md:p-14 fade-in relative shadow-lg">
                                <div className="absolute top-0 right-14 -translate-y-1/2 bg-yellow-400 text-yellow-900 font-black px-8 py-3 rounded-2xl text-2xl shadow-md border-2 border-yellow-200">
                                    כיוון חשיבה (טריק) 💡
                                </div>
                                {activeProblem.trick}
                            </div>
                        )}

                        {step >= 2 && (
                            <div className="mt-16 bg-slate-50 border-[6px] border-emerald-400 rounded-[3rem] p-10 md:p-14 fade-in relative shadow-lg">
                                <div className="absolute top-0 right-14 -translate-y-1/2 bg-emerald-500 text-white font-black px-8 py-3 rounded-2xl text-2xl shadow-md border-2 border-emerald-300">
                                    הפתרון המלא צעד-אחר-צעד 🎯
                                </div>
                                {activeProblem.solution}
                            </div>
                        )}
                    </div>
                </div>
            );
        };

        const App = () => {
            const [activeTab, setActiveTab] = useState('basics');

            const menu = [
                { id: 'basics', label: 'הנוסחה והבסיס', icon: icons.book },
                { id: 'tricks', label: 'טריקי הקסם', icon: icons.magic },
                { id: 'multipliers', label: 'כסף והכפלות', icon: icons.money },
                { id: 'questions', label: 'שאלות מהחיים', icon: icons.board },
            ];

            return (
                <div className="min-h-screen pb-24 md:pb-12 bg-[#f8fafc] font-rubik relative overflow-hidden">
                    <div className="fixed top-[-20%] left-[-10%] w-[50%] h-[50%] bg-blue-200/40 rounded-full blur-[120px] z-0 pointer-events-none"></div>
                    <div className="fixed bottom-[-20%] right-[-10%] w-[50%] h-[50%] bg-indigo-200/30 rounded-full blur-[120px] z-0 pointer-events-none"></div>

                    <div className="bg-white/90 backdrop-blur-xl border-b-2 border-slate-200 sticky top-0 z-50 shadow-sm relative z-10 mb-10">
                        <div className="max-w-7xl mx-auto px-6">
                            <div className="flex justify-between items-center py-4">
                                <div className="flex items-center gap-6">
                                    <div className="bg-gradient-to-br from-indigo-500 to-purple-600 text-white p-4 rounded-2xl shadow-lg shadow-indigo-200/50 transform rotate-3">
                                        <Icon path={<><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="3"></circle><circle cx="17.5" cy="17.5" r="3"></circle></>} size={36} />
                                    </div>
                                    <div>
                                        <h1 className="text-4xl font-black text-slate-800 tracking-tight drop-shadow-sm">מאסטר האחוזים</h1>
                                        <p className="text-slate-500 font-bold text-xl tracking-wide">מצב לוח חכם לכיתה</p>
                                    </div>
                                </div>
                                <div className="hidden lg:flex gap-3 bg-slate-100/50 p-2 rounded-2xl border border-slate-200">
                                    {menu.map(item => (
                                        <button
                                            key={item.id}
                                            onClick={() => setActiveTab(item.id)}
                                            className={`flex items-center gap-3 px-8 py-4 font-black text-2xl rounded-xl transition-all
                                                ${activeTab === item.id 
                                                    ? 'bg-white text-indigo-600 shadow-md border-2 border-indigo-100 scale-105' 
                                                    : 'text-slate-500 hover:bg-slate-200/50 hover:text-slate-700'
                                                }`}
                                        >
                                            {item.icon}
                                            <span>{item.label}</span>
                                        </button>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div className="lg:hidden fixed bottom-0 left-0 right-0 bg-white border-t-[3px] border-slate-200 z-50 shadow-[0_-10px_20px_rgba(0,0,0,0.1)] pb-safe">
                        <div className="flex justify-around items-center p-3">
                            {menu.map(item => (
                                <button
                                    key={item.id}
                                    onClick={() => setActiveTab(item.id)}
                                    className={`flex flex-col items-center gap-2 p-3 rounded-2xl transition-all flex-1
                                        ${activeTab === item.id 
                                            ? 'text-indigo-600 bg-indigo-50 font-black shadow-inner border border-indigo-100' 
                                            : 'text-slate-400 font-bold hover:bg-slate-50'
                                        }`}
                                >
                                    {React.cloneElement(item.icon, { size: activeTab === item.id ? 32 : 28 })}
                                    <span className="text-sm md:text-lg">{item.label}</span>
                                </button>
                            ))}
                        </div>
                    </div>

                    <main className="max-w-[1000px] mx-auto p-8 relative z-10 pb-32">
                        {activeTab === 'basics' && <BasicsTab />}
                        {activeTab === 'tricks' && <TricksTab />}
                        {activeTab === 'multipliers' && <MultipliersTab />}
                        {activeTab === 'questions' && <WordProblemsTab />}
                    </main>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
