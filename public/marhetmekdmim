    function baseGrid(minX, maxX, minY, maxY) {
      const w = canvas.width, h = canvas.height;
      const pad = 60;
      const scaleX = (w - pad * 2) / (maxX - minX);
      const scaleY = (h - pad * 2) / (maxY - minY);
      const toX = x => pad + (x - minX) * scaleX;
      const toY = y => h - pad - (y - minY) * scaleY;

      ctx.clearRect(0, 0, w, h);

      ctx.strokeStyle = '#f3f4f6';
      ctx.lineWidth = 1.5;
      for (let x = Math.ceil(minX); x <= Math.floor(maxX); x++) {
        const px = toX(x);
        ctx.beginPath(); ctx.moveTo(px, pad/2); ctx.lineTo(px, h - pad/2); ctx.stroke();
      }
      for (let y = Math.ceil(minY); y <= Math.floor(maxY); y++) {
        const py = toY(y);
        ctx.beginPath(); ctx.moveTo(pad/2, py); ctx.lineTo(w - pad/2, py); ctx.stroke();
      }

      ctx.strokeStyle = '#1f2937';
      ctx.lineWidth = 2.5;
      if (minY <= 0 && maxY >= 0) { 
        ctx.beginPath(); ctx.moveTo(pad/2, toY(0)); ctx.lineTo(w - pad/2, toY(0)); ctx.stroke(); 
        ctx.beginPath(); ctx.moveTo(w - pad/2, toY(0)); ctx.lineTo(w - pad/2 - 10, toY(0) - 5); ctx.lineTo(w - pad/2 - 10, toY(0) + 5); ctx.fill();
      }
      if (minX <= 0 && maxX >= 0) { 
        ctx.beginPath(); ctx.moveTo(toX(0), h - pad/2); ctx.lineTo(toX(0), pad/2); ctx.stroke(); 
        ctx.beginPath(); ctx.moveTo(toX(0), pad/2); ctx.lineTo(toX(0) - 5, pad/2 + 10); ctx.lineTo(toX(0) + 5, pad/2 + 10); ctx.fill();
      }

      ctx.font = 'bold 18px Heebo';
      ctx.fillStyle = '#6b7280';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      for (let x = Math.ceil(minX); x <= Math.floor(maxX); x++) {
        if (x === 0) continue;
        ctx.fillText(String(x), toX(x), (minY <= 0 && maxY >= 0) ? toY(0) + 20 : h - pad/2 + 15);
      }
      for (let y = Math.ceil(minY); y <= Math.floor(maxY); y++) {
        if (y === 0) continue;
        ctx.fillText(String(y), (minX <= 0 && maxX >= 0) ? toX(0) - 20 : pad/2 - 15, toY(y));
      }

      return { toX, toY, w, h };
    }

    function drawGraph(example, stepIndex) {
      const xInt = example.point.x;
      const yInt = example.point.y;
      
      const minX = Math.min(-2, xInt - 4);
      const maxX = Math.max(8, xInt + 4);
      const minY = Math.min(-3, yInt - 4);
      const maxY = Math.max(8, yInt + 4);
      
      const { toX, toY } = baseGrid(minX, maxX, minY, maxY);

      example.lines.forEach((line) => {
        const xA = minX, yA = line.m * xA + line.b;
        const xB = maxX, yB = line.m * xB + line.b;
        ctx.strokeStyle = line.color;
        ctx.lineWidth = 4;
        ctx.beginPath(); ctx.moveTo(toX(xA), toY(yA)); ctx.lineTo(toX(xB), toY(yB)); ctx.stroke();
        
        if (stepIndex >= example.steps.length - 2) {
            ctx.fillStyle = line.color;
            ctx.font = 'bold 22px Heebo';
            ctx.textAlign = 'center';
            ctx.direction = 'ltr';
            
            const lx = minX + (maxX-minX)*0.75;
            const ly = line.m * lx + line.b;
            
            ctx.save();
            ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
            const textWidth = ctx.measureText(line.label).width;
            ctx.fillRect(toX(lx) - textWidth/2 - 5, toY(ly) - 35, textWidth + 10, 24);
            ctx.restore();

            ctx.fillText(line.label, toX(lx), toY(ly) - 17);
        }
      });

      if (stepIndex >= example.steps.length - 1) {
        const px = toX(xInt), py = toY(yInt);
        
        ctx.strokeStyle = '#059669';
        ctx.lineWidth = 2;
        ctx.setLineDash([6, 6]);
        ctx.beginPath();
        ctx.moveTo(px, py); ctx.lineTo(px, toY(0));
        ctx.moveTo(px, py); ctx.lineTo(toX(0), py);
        ctx.stroke();
        ctx.setLineDash([]);
        
        ctx.fillStyle = '#059669';
        ctx.beginPath(); ctx.arc(px, py, 8, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 3;
        ctx.stroke();

        ctx.save();
        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
        ctx.beginPath();
        ctx.roundRect(px - 75, py - 65, 150, 52, 12);
        ctx.fill();
        ctx.strokeStyle = '#059669';
        ctx.lineWidth = 1.5;
        ctx.stroke();

        ctx.fillStyle = '#064e3b';
        ctx.textAlign = 'center';
        ctx.direction = 'rtl';
        ctx.font = '900 18px Heebo';
        ctx.fillText('מפגש הישרים', px, py - 43);
        
        ctx.direction = 'ltr';
        ctx.font = 'bold 19px Heebo';
        ctx.fillText(pointText(xInt, yInt), px, py - 20);
        ctx.restore();
      }
    }

    function switchTab(id) {
      currentTab = Number(id);
      currentStep = 0;
      tabButtons.forEach(btn => btn.classList.toggle('פעיל', Number(btn.dataset.tab) === currentTab));
      renderStep();
    }

    tabButtons.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
    nextBtn.addEventListener('click', () => {
      if (currentTab === 5) return;
      const max = examples[currentTab].steps.length - 1;
      if (currentStep < max) { currentStep += 1; renderStep(); }
    });
    prevBtn.addEventListener('click', () => {
      if (currentTab === 5) return;
      if (currentStep > 0) { currentStep -= 1; renderStep(); }
    });
    startBtn.addEventListener('click', () => { currentStep = 0; renderStep(); });

    switchTab(1);
  </script>
</body>
